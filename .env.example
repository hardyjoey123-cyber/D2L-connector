# Your Brightspace instance's hostname (no path), e.g. mycollege.brightspace.com
BRIGHTSPACE_DOMAIN=

# Which auth method to use:
#   "oauth"   - recommended, requires an admin-registered OAuth app
#   "apikey"  - legacy Valence ID/Key, also requires admin-registered app
#   "session" - no admin/API access needed; replays your own logged-in browser
#               session cookies. See README "Session cookie workaround".
BRIGHTSPACE_AUTH_METHOD=oauth

# --- OAuth 2.0 (BRIGHTSPACE_AUTH_METHOD=oauth) ---
# Register an OAuth 2.0 app in Brightspace Admin Tools > API Management to get these.
# Redirect URI registered there must match BRIGHTSPACE_OAUTH_REDIRECT_URI used by
# `npm run auth:oauth` (default http://localhost:8918/callback).
BRIGHTSPACE_CLIENT_ID=
BRIGHTSPACE_CLIENT_SECRET=
# Obtained by running `npm run auth:oauth` once.
BRIGHTSPACE_REFRESH_TOKEN=
# Usually don't need to change these:
# BRIGHTSPACE_OAUTH_AUTHORIZE_URL=https://auth.brightspace.com/oauth2/auth
# BRIGHTSPACE_OAUTH_TOKEN_URL=https://auth.brightspace.com/core/connect/token
# BRIGHTSPACE_OAUTH_SCOPE=core:*:* content:toc:read enrollment:orgunit:read grades:gradeobject:read grades:gradevalue:read dropbox:folder:read dropbox:file:read
# BRIGHTSPACE_OAUTH_REDIRECT_URI=http://localhost:8918/callback
# BRIGHTSPACE_OAUTH_CALLBACK_PORT=8918

# --- Legacy Valence ID/Key (BRIGHTSPACE_AUTH_METHOD=apikey) ---
# Obtained when registering an "API Application" in Brightspace, plus running
# `npm run auth:apikey` once to get a per-user User Id/User Key pair.
BRIGHTSPACE_APP_ID=
BRIGHTSPACE_APP_KEY=
BRIGHTSPACE_USER_ID=
BRIGHTSPACE_USER_KEY=

# --- Session cookie workaround (BRIGHTSPACE_AUTH_METHOD=session) ---
# Generated by `npm run auth:session`; you normally don't need to set this
# manually, but can point it elsewhere if desired.
# BRIGHTSPACE_SESSION_STATE_PATH=.auth/storageState.json

# --- Optional: pin specific Brightspace API versions instead of auto-discovery ---
# BRIGHTSPACE_LP_VERSION=1.43
# BRIGHTSPACE_LE_VERSION=1.79

# =============================================================================
# JARVIS voice interface (web/) — unrelated to the Brightspace settings above.
# Only needed if you run `npm run jarvis`.
# =============================================================================

# Required. Your Anthropic API key: https://console.anthropic.com/settings/keys
# It is read by the local server only and is never sent to the browser.
ANTHROPIC_API_KEY=

# Only needed if your key is NOT scoped to a workspace. Organization-level
# keys must name a workspace on every request; the API says so explicitly if
# yours does. Simplest fix is to create a workspace-scoped key instead.
# ANTHROPIC_WORKSPACE_ID=

# Optional overrides:
# JARVIS_PORT=8917
# JARVIS_HOST=127.0.0.1
# JARVIS_MODEL=claude-opus-5
# Thinking depth. Voice is latency-sensitive, so this defaults to "low";
# raise it (medium/high/xhigh/max) to trade response time for depth.
# JARVIS_EFFORT=low
# JARVIS_MAX_TOKENS=2000
# Replace the spoken-answer instructions entirely (persona, length, style).
# JARVIS_SYSTEM_PROMPT=

# --- Optional: read a brokerage account out loud (voice interface) ---
# A remote MCP server the Claude API calls on your behalf. The voice app is a
# separate program from any Claude session, so it needs its own URL and token —
# it cannot borrow a connector configured elsewhere.
#
# Access is READ-ONLY and enforced by the API through an allowed_tools list:
# balances, positions, orders, quotes, news, realized P&L. Placing, changing or
# cancelling an order is deliberately not available, because speech recognition
# is not a safe way to authorise money movement.
# JARVIS_MCP_URL=
# Most servers want an OAuth sign-in rather than a pasted token: set the URL
# above, then run `npm run account:login` once. JARVIS_MCP_TOKEN is only for
# servers that issue a long-lived token directly.
# JARVIS_MCP_TOKEN=
# JARVIS_MCP_NAME=trading
# JARVIS_OAUTH_CALLBACK_PORT=8919

# --- Optional: let the assistant place trades (off by default) ---
# The model never places an order itself. It calls propose_trade, and this
# server places it — a path nothing the model says can reach directly.
#
# Enabling this is a change to how trades enter your account. If a trading
# rulebook governs the account, amend it too — an ad-hoc spoken trade does not
# come from whatever signal sources that rulebook requires.
# JARVIS_TRADING=enabled

# What has to happen between the words and the order:
#   typed     — you type the ticker on screen. Nothing places without it. (default)
#   countdown — hands-free. It says what it is placing, then places it a few
#               seconds later unless you say "cancel", press Esc, or click Cancel.
#   none      — placed immediately, with nothing in between.
# Speech recognition mishears words. countdown keeps your hands free while still
# leaving somewhere for a misheard order to be stopped; none removes that.
# JARVIS_TRADING_CONFIRM=typed
# How many seconds countdown mode waits. Longer is more room to catch a mistake,
# and the assistant is usually still speaking for the first few.
# JARVIS_TRADING_COUNTDOWN=8

# Per-order ceiling in dollars. A misheard number cannot talk its way past it.
# JARVIS_MAX_TRADE_USD=200
# Ceiling on everything bought in a day, across orders. This is the backstop
# that matters most without a person in the loop: one bad afternoon stays
# bounded even if every single order looks reasonable. 0 turns it off.
# JARVIS_DAILY_TRADE_USD=1000
# The brokerage account orders are placed in.
# JARVIS_TRADING_ACCOUNT=

# Your trading bot's rules, in a file. Whatever is in it has to be satisfied
# before a trade is proposed. Created for you on first start from
# trading-rules.example.md, and never committed, so pasting your rules in is
# the whole job. See the "Your own trading rules" section of the README.
# JARVIS_TRADING_RULES=trading-rules.md
# Every order this program sends is appended here, successes and failures alike.
# JARVIS_TRADE_LOG=trade-log.md
